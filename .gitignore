# Local client copies and runtime evidence stay on this machine.
/runtime/
/runs/
/data/v1649370/*.sqlite3

# Third-party material has its own provenance and repository.
/codol-ember/
/他人文件参考/

# Generated Python files.
__pycache__/
*.py[cod]
.venv/
venv/

# Prevent accidental addition of client binaries, archives, dumps, and keys.
*.exe
*.dll
*.ifs
*.ff
*.lf
*.7z
*.zip
*.rar
*.bin
*.dmp
*.mdmp
*.etl
*.key
*.pem
*.crt
*.pfx
*.p12
*.log
*.jsonl
*.tmp
*.bak
*.orig
*.sqlite
*.db
*.png
.env
.env.*

# M3 evidence screenshots must be versioned
!evidence/**/*.png
